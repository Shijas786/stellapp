datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  chatId         String   @unique // WhatsApp phone number, e.g. "919876543210@c.us" or "101528765505641@lid"
  phoneNumber    String?  @unique // Raw phone digits, e.g. "919876543210"
  username       String?  @unique // Custom federated username, e.g. "bob"
  stellarPublic  String   @unique
  stellarSecret  String   // AES-256-GCM encrypted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  onboarded      Boolean  @default(false)
  contacts       Contact[]
}

// Stores conversation/session state for WhatsApp chat workflows
model SessionState {
  chatId    String   @id
  stateJson String   // JSON-serialized state
  updatedAt DateTime @default(now()) @updatedAt
}

model Contact {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String
  createdAt   DateTime @default(now())

  @@unique([ownerId, name])
}

// Registry for deployed OpenZeppelin Confidential Token wrappers per asset
model ConfidentialRegistry {
  assetCode        String   @id // e.g. "XLM" or "USDC"
  tokenContract    String
  verifierContract String
  auditorContract  String
  deployedAt       DateTime @default(now())
}

// Persists reconstructed cryptographic account state across process restarts / Railway
// redeploys. The JSON file store (json-store.ts) is ephemeral on Railway; this table
// gives every confidential-token account a durable home for its openings (v, r),
// sync cursor, and synced ledger. Keyed by stateKey = sha256(passphrase|token|pubkey).
model ConfidentialState {
  stateKey      String   @id       // sha256 key matching getStateStore() in confidential_token.ts
  stateJson     String             // Full AccountState serialised as JSON (bigints as "0x…")
  updatedAt     DateTime @default(now()) @updatedAt
}

// Stores message histories for AI Agent conversations
model ChatHistory {
  chatId    String   @id
  messages  String   // JSON-serialized array of OpenAI messages
  updatedAt DateTime @default(now()) @updatedAt
}

// Background recurring swap jobs (DCA)
model RecurringSwapJob {
  id              String   @id @default(uuid())
  chatId          String
  fromAsset       String
  toAsset         String
  amountPerSwap   String
  intervalSeconds Int
  totalSwaps      Int
  swapsCompleted  Int      @default(0)
  isActive        Boolean  @default(true)
  lastExecutedAt  DateTime @default(now())
  txHashes        String   @default("")
  statusMessageId String?
  createdAt       DateTime @default(now())

  @@index([isActive])
  @@index([chatId])
}

// Background recurring transfer jobs (Allowance / Rent)
model RecurringTransferJob {
  id               String   @id @default(uuid())
  chatId           String
  recipientAddr    String   // The resolved G-address
  recipientName    String?  // Friendly contact name if resolved
  amountPerTransfer String
  assetCode        String   @default("USDC") // "USDC" or "XLM"
  intervalSeconds  Int
  totalTransfers   Int
  transfersCompleted Int    @default(0)
  isActive         Boolean  @default(true)
  lastExecutedAt   DateTime @default(now())
  txHashes         String   @default("")
  statusMessageId  String?
  createdAt        DateTime @default(now())

  @@index([isActive])
  @@index([chatId])
}

// Background limit orders (Price-triggered swaps)
model LimitOrderJob {
  id              String   @id @default(uuid())
  chatId          String
  fromAsset       String
  toAsset         String
  amount          String   // Amount of source asset to swap
  triggerPrice    String   // Target price threshold (expressed as units of USDC per XLM)
  condition       String   // "LESS_THAN_OR_EQUAL" or "GREATER_THAN_OR_EQUAL"
  isActive        Boolean  @default(true)
  txHash          String?
  createdAt       DateTime @default(now())

  @@index([isActive])
  @@index([chatId])
}

model AlertJob {
  id               String   @id @default(uuid())
  chatId           String
  alertType        String   // "REMINDER", "BALANCE", "PRICE", "TRANSACTION"
  triggerCondition String   // e.g. "2026-07-08T22:30:00Z" (reminder date), "XLM < 5.0" (low balance), "XLM >= 0.15" (price targets), "+919876543210" (incoming tx)
  message          String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([isActive])
  @@index([chatId])
}


